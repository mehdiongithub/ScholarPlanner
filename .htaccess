# Disable directory listing
Options -Indexes

# Block direct access to sensitive folders
RewriteEngine On

# Reject access to system directories with 403 Forbidden
RewriteRule ^(app|config|tests|routes|database|cron|\.git)($|/) - [F,L]
RewriteRule ^storage/(private_uploads|logs|cache)($|/) - [F,L]

# Protect .env and composer files
<FilesMatch "^\.env">
    Order allow,deny
    Deny from all
</FilesMatch>

<FilesMatch "^composer\.(json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Canonical HTTPS & non-www redirect for scholarplanner.com (single 301 hop to eliminate redirect chains)
RewriteCond %{HTTP_HOST} ^www\.scholarplanner\.com$ [NC,OR]
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?scholarplanner\.com$ [NC]
RewriteRule ^(.*)$ https://scholarplanner.com/$1 [L,R=301]

# Redirect all requests to index.php if they are not existing files/directories
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

# ==============================================================================
# GZIP / BROTLI COMPRESSION (mod_deflate)
# ==============================================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript application/json application/xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff2 font/woff font/ttf
</IfModule>

# ==============================================================================
# BROWSER CACHE HEADERS (mod_expires & mod_headers)
# ==============================================================================
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # Static Media & Images: 1 year immutable
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"

    # CSS & JavaScript: 1 year (versioned via asset() ?v=)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"

    # Web Fonts: 1 year
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/ttf "access plus 1 year"

    # HTML / Dynamic: Never cache dynamic responses
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # 1-year immutable cache for static assets with cache-busting version query
    <FilesMatch "\.(webp|png|jpe?g|gif|svg|ico|css|js|woff2|woff|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Dynamic PHP responses must not be cached to safeguard sessions, CSRF, and data
    <FilesMatch "\.php$">
        Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
        Header set Pragma "no-cache"
    </FilesMatch>

    Header append Vary Accept-Encoding
</IfModule>
